# ============================================================================
# Git Ignore Patterns
# ============================================================================

# SOPS secrets (decrypted files)
# These files are generated by sops-nix and should never be committed
secrets/*.json
secrets/*.bin

# Keep encrypted files and configuration
!secrets/.sops.yaml
!secrets/*.yaml
!secrets/*.yml

# Result symlinks from nix builds
result
result-*

# Editor files
*.swp
*.swo
*~
.\#*
\#*\#

# macOS
.DS_Store

# IDE
.idea/
.vscode/
