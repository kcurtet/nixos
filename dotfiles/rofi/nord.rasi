/* ============================================================================
 * Nord Theme for Rofi
 * Based on https://www.nordtheme.com
 * ============================================================================ */

* {
    /* Nord palette */
    nord0:  #2e3440;
    nord1:  #3b4252;
    nord2:  #434c5e;
    nord3:  #4c566a;
    nord4:  #d8dee9;
    nord5:  #e5e9f0;
    nord6:  #eceff4;
    nord7:  #8fbcbb;
    nord8:  #88c0d0;
    nord9:  #81a1c1;
    nord10: #5e81ac;
    nord11: #bf616a;
    nord12: #d08770;
    nord13: #ebcb8b;
    nord14: #a3be8c;
    nord15: #b48ead;

    background-color: transparent;
    text-color:       @nord4;
    font:             "JetBrainsMono Nerd Font 12";
}

window {
    background-color: @nord0;
    border:           2px solid;
    border-color:     @nord9;
    border-radius:    8px;
    width:            40%;
    padding:          0;
}

mainbox {
    background-color: @nord0;
    children:         [ inputbar, listview, message ];
    spacing:          0;
    padding:          0;
}

inputbar {
    background-color: @nord1;
    text-color:       @nord6;
    padding:          12px 16px;
    children:         [ prompt, textbox-prompt-sep, entry ];
}

prompt {
    text-color: @nord8;
}

textbox-prompt-sep {
    expand:     false;
    str:        " ";
    text-color: @nord3;
}

entry {
    text-color:       @nord6;
    placeholder-color: @nord3;
    placeholder:      "Search...";
}

listview {
    background-color: @nord0;
    lines:            12;
    columns:          1;
    scrollbar:        false;
    padding:          8px 0;
    fixed-height:     true;
}

element {
    padding:          8px 16px;
    spacing:          8px;
}

element normal.normal {
    background-color: @nord0;
    text-color:       @nord4;
}

element normal.active {
    background-color: @nord0;
    text-color:       @nord8;
}

element selected.normal {
    background-color: @nord2;
    text-color:       @nord8;
    border:           0 0 0 3px solid;
    border-color:     @nord8;
}

element selected.active {
    background-color: @nord2;
    text-color:       @nord13;
    border:           0 0 0 3px solid;
    border-color:     @nord13;
}

element alternate.normal {
    background-color: @nord0;
    text-color:       @nord4;
}

element-icon {
    size: 24px;
}

element-text {
    text-color: inherit;
}

message {
    background-color: @nord1;
    padding:          8px 16px;
}

textbox {
    text-color: @nord4;
}

scrollbar {
    handle-color: @nord3;
    handle-width: 4px;
}
