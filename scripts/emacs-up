#!/usr/bin/env bash
# ============================================================================
# emacs-up — Update straight.el packages (like doom upgrade)
# ============================================================================
set -euo pipefail

EMACS="${EMACS:-emacs}"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/emacs"
STRAIGHT_DIR="$CONFIG_DIR/straight"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}"
LOG_FILE="$CACHE_DIR/emacs-up.log"
DRY_RUN=false
LOGGING=false
JOBS="${JOBS:-$(nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 4)}"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

info()    { echo -e "${BLUE}→${NC} $1"; log "INFO" "$1"; }
success() { echo -e "${GREEN}✓${NC} $1"; log "SUCCESS" "$1"; }
warn()    { echo -e "${YELLOW}!${NC} $1"; log "WARN" "$1"; }
error()   { echo -e "${RED}✗${NC} $1"; log "ERROR" "$1"; exit 1; }

log() {
    [[ "$LOGGING" == true ]] || return 0
    local level="$1" msg="$2"
    local timestamp
    timestamp=$(date "+%Y-%m-%d %H:%M:%S")
    mkdir -p "$(dirname "$LOG_FILE")"
    echo "[$timestamp] [$level] $msg" >> "$LOG_FILE"
}

# Timer functions for elapsed time reporting
_TIMER_START=0
timer_start() { _TIMER_START=$(date +%s); }
timer_end() {
    local elapsed=$(( $(date +%s) - _TIMER_START ))
    local mins=$(( elapsed / 60 ))
    local secs=$(( elapsed % 60 ))
    if [[ $mins -gt 0 ]]; then
        echo "${mins}m ${secs}s"
    else
        echo "${secs}s"
    fi
}

# Count directories in a path (excluding the path itself)
count_dirs() {
    local path="$1"
    if [[ -d "$path" ]]; then
        local count
        count=$(find "$path" -maxdepth 1 -type d | wc -l)
        echo $((count - 1))  # Subtract 1 for the directory itself
    else
        echo 0
    fi
}

usage() {
    cat <<EOF
Usage: emacs-up [OPTIONS] [COMMAND]

Commands:
  update     Pull all packages from upstream (default)
  rebuild    Rebuild all packages (after Emacs upgrade)
  freeze     Save current versions to versions.lock
  thaw       Restore packages from versions.lock
  clean      Remove unused packages and repos
  purge      Remove entire straight directory (nuclear option)
  status     Show package counts and lockfile status

Options:
  -n, --dry-run    Show what would happen without making changes
  -l, --log        Save output to $LOG_FILE

Environment:
  EMACS     Emacs binary to use (default: emacs)
  JOBS      Parallel build jobs (default: \$(nproc))

Examples:
  emacs-up           # Update all packages
  emacs-up rebuild   # Rebuild after Emacs version change
  emacs-up freeze    # Lock current versions
  emacs-up -n clean  # Preview cleanup (dry run)
  emacs-up -l        # Update with logging
  JOBS=8 emacs-up    # Use 8 parallel build jobs
EOF
}

check_emacs() {
    if ! command -v "$EMACS" &>/dev/null; then
        error "Emacs not found. Install Emacs first or set EMACS env var."
    fi
}

check_config() {
    if [[ ! -f "$CONFIG_DIR/init.el" ]]; then
        error "No init.el found at $CONFIG_DIR\n       Configure Emacs first or set XDG_CONFIG_HOME correctly."
    fi
}

check_straight() {
    if [[ ! -d "$STRAIGHT_DIR/repos/straight.el" ]]; then
        warn "straight.el not found. Starting Emacs to bootstrap..."
        # Start Emacs in batch mode to trigger straight bootstrap
        # Filter noise but keep errors visible
        "$EMACS" --batch \
            --eval "(setq user-emacs-directory \"$CONFIG_DIR/\")" \
            --eval "(load \"$CONFIG_DIR/early-init.el\" nil t)" \
            --eval "(load \"$CONFIG_DIR/init.el\" nil t)" \
            2>&1 | grep -v "^Loading\|^Wrote\|^Compiling" || true

        if [[ ! -d "$STRAIGHT_DIR/repos/straight.el" ]]; then
            error "Failed to bootstrap straight.el. Check your init.el configuration."
        fi
        success "straight.el bootstrapped"
    fi
}

run_straight_cmd() {
    local cmd="$1"
    if [[ "$DRY_RUN" == true ]]; then
        info "[DRY-RUN] Would run Emacs command: $cmd"
        return 0
    fi
    log "CMD" "Running: $cmd"

    if [[ "$LOGGING" == true ]]; then
        "$EMACS" --batch \
            --eval "(setq user-emacs-directory \"$CONFIG_DIR/\")" \
            --eval "(setq straight--build-concurrency $JOBS)" \
            --eval "(load \"$CONFIG_DIR/early-init.el\" nil t)" \
            --eval "(load \"$CONFIG_DIR/init.el\" nil t)" \
            --eval "$cmd" \
            2>&1 | tee -a "$LOG_FILE" | grep -v "^Loading\|^Wrote" || true
    else
        "$EMACS" --batch \
            --eval "(setq user-emacs-directory \"$CONFIG_DIR/\")" \
            --eval "(setq straight--build-concurrency $JOBS)" \
            --eval "(load \"$CONFIG_DIR/early-init.el\" nil t)" \
            --eval "(load \"$CONFIG_DIR/init.el\" nil t)" \
            --eval "$cmd" \
            2>&1 | grep -v "^Loading\|^Wrote" || true
    fi
}

cmd_update() {
    check_emacs
    check_config
    check_straight

    timer_start
    local repos_before builds_before
    repos_before=$(count_dirs "$STRAIGHT_DIR/repos")
    builds_before=$(count_dirs "$STRAIGHT_DIR/build")

    info "Updating straight.el packages... ($repos_before repos, $JOBS jobs)"
    run_straight_cmd "straight-pull-all"

    local repos_after builds_after
    repos_after=$(count_dirs "$STRAIGHT_DIR/repos")
    builds_after=$(count_dirs "$STRAIGHT_DIR/build")

    echo ""
    success "Packages updated ($(timer_end))"
    echo -e "  Repos:  ${repos_before} → ${repos_after}"
    echo -e "  Builds: ${builds_before} → ${builds_after}"
    [[ "$LOGGING" == true ]] && echo -e "  Log:    $LOG_FILE"

    # Show summary
    if [[ -f "$STRAIGHT_DIR/versions.lock.el" ]]; then
        local count
        count=$(grep -c "(:type" "$STRAIGHT_DIR/versions.lock.el" 2>/dev/null || echo "0")
        info "Lockfile has $count packages"
    fi
}

cmd_rebuild() {
    check_emacs
    check_config
    check_straight

    timer_start
    local builds_before
    builds_before=$(count_dirs "$STRAIGHT_DIR/build")

    info "Rebuilding all packages... ($builds_before builds, $JOBS jobs)"
    run_straight_cmd "straight-rebuild-all"

    local builds_after
    builds_after=$(count_dirs "$STRAIGHT_DIR/build")

    echo ""
    success "Packages rebuilt ($(timer_end))"
    echo -e "  Builds: ${builds_before} → ${builds_after}"
    [[ "$LOGGING" == true ]] && echo -e "  Log:    $LOG_FILE"
}

cmd_freeze() {
    check_emacs
    check_config
    check_straight

    timer_start
    info "Freezing package versions..."
    run_straight_cmd "(straight-freeze-versions)"

    if [[ "$DRY_RUN" == true ]]; then
        info "[DRY-RUN] Would write: $STRAIGHT_DIR/versions.lock.el"
    else
        success "Versions saved to $STRAIGHT_DIR/versions.lock.el ($(timer_end))"
    fi
}

cmd_thaw() {
    check_emacs
    check_config

    if [[ ! -f "$STRAIGHT_DIR/versions.lock.el" ]]; then
        error "No versions.lock.el found. Run 'emacs-up freeze' first."
    fi

    check_straight

    timer_start
    info "Thawing packages from lockfile..."
    run_straight_cmd "(straight-thaw-versions)"
    success "Packages restored from lockfile ($(timer_end))"
    [[ "$LOGGING" == true ]] && echo -e "  Log:    $LOG_FILE"
}

cmd_clean() {
    check_emacs
    check_config
    check_straight

    timer_start
    info "Cleaning unused packages..."
    run_straight_cmd "(progn (straight-prune-build) (straight-remove-unused-repos 'no-confirm))"
    success "Cleaned unused packages ($(timer_end))"
}

cmd_purge() {
    if [[ ! -d "$STRAIGHT_DIR" ]]; then
        warn "Straight directory doesn't exist: $STRAIGHT_DIR"
        exit 0
    fi

    if [[ "$DRY_RUN" == true ]]; then
        info "[DRY-RUN] Would delete: $STRAIGHT_DIR"
        exit 0
    fi

    warn "This will delete $STRAIGHT_DIR entirely!"
    read -rp "Continue? [y/N] " confirm

    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        rm -rf "$STRAIGHT_DIR"
        success "Straight directory removed. Run emacs to reinstall."
    else
        info "Aborted"
    fi
}

cmd_status() {
    check_emacs

    echo -e "${BLUE}Emacs Config Status${NC}"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

    # Emacs version
    local emacs_ver
    emacs_ver=$("$EMACS" --version | head -1 2>/dev/null || echo "not found")
    echo -e "Emacs:          ${GREEN}$emacs_ver${NC}"

    # Config dir
    if [[ -d "$CONFIG_DIR" ]]; then
        echo -e "Config dir:     ${GREEN}$CONFIG_DIR${NC}"
    else
        echo -e "Config dir:     ${RED}not found${NC}"
        exit 0
    fi

    # init.el
    if [[ -f "$CONFIG_DIR/init.el" ]]; then
        echo -e "init.el:        ${GREEN}found${NC}"
    else
        echo -e "init.el:        ${RED}not found${NC}"
        exit 0
    fi

    # early-init.el
    if [[ -f "$CONFIG_DIR/early-init.el" ]]; then
        echo -e "early-init.el:  ${GREEN}found${NC}"
    else
        echo -e "early-init.el:  ${YELLOW}not found${NC}"
    fi

    # Straight dir
    if [[ -d "$STRAIGHT_DIR" ]]; then
        local repo_count build_count
        repo_count=$(count_dirs "$STRAIGHT_DIR/repos")
        build_count=$(count_dirs "$STRAIGHT_DIR/build")
        echo -e "Straight dir:   ${GREEN}initialized${NC}"
        echo -e "Repos:          ${GREEN}$repo_count${NC}"
        echo -e "Builds:         ${GREEN}$build_count${NC}"
    else
        echo -e "Straight dir:   ${YELLOW}not initialized${NC}"
        exit 0
    fi

    # Lockfile
    local lockfile="$STRAIGHT_DIR/versions.lock.el"
    if [[ -f "$lockfile" ]]; then
        local lock_count lock_date
        lock_count=$(grep -c "(:type" "$lockfile" 2>/dev/null || echo "0")
        # Get modification time (GNU and BSD stat compatibility)
        if stat -c %Y "$lockfile" &>/dev/null; then
            # GNU stat
            lock_date=$(date -d "@$(stat -c %Y "$lockfile")" "+%Y-%m-%d %H:%M" 2>/dev/null || echo "unknown")
        elif stat -f %m "$lockfile" &>/dev/null; then
            # BSD stat (macOS)
            lock_date=$(date -r "$(stat -f %m "$lockfile")" "+%Y-%m-%d %H:%M" 2>/dev/null || echo "unknown")
        else
            lock_date="unknown"
        fi
        echo -e "Lockfile:       ${GREEN}$lock_count packages (last: $lock_date)${NC}"
    else
        echo -e "Lockfile:       ${YELLOW}not found${NC}"
    fi

    # Straight version
    if [[ -f "$STRAIGHT_DIR/repos/straight.el/straight.el" ]]; then
        local straight_version
        straight_version=$(grep -m1 "Version:" "$STRAIGHT_DIR/repos/straight.el/straight.el" 2>/dev/null | awk '{print $3}' || echo "unknown")
        echo -e "Straight ver:   ${GREEN}$straight_version${NC}"
    fi
}

# Parse options
while [[ $# -gt 0 ]]; do
    case "$1" in
        -n|--dry-run)
            DRY_RUN=true
            shift
            ;;
        -l|--log)
            LOGGING=true
            shift
            ;;
        -h|--help|help)
            usage
            exit 0
            ;;
        *)
            break
            ;;
    esac
done

# Main
case "${1:-update}" in
    update)  cmd_update ;;
    rebuild) cmd_rebuild ;;
    freeze)  cmd_freeze ;;
    thaw)    cmd_thaw ;;
    clean)   cmd_clean ;;
    purge)   cmd_purge ;;
    status)  cmd_status ;;
    *)       error "Unknown command: $1. Use --help for usage." ;;
esac
