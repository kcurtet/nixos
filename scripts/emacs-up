#!/usr/bin/env bash
# ============================================================================
# emacs-up — Update straight.el packages (like doom upgrade)
# ============================================================================
set -euo pipefail

EMACS="${EMACS:-emacs}"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/emacs"
STRAIGHT_DIR="$CONFIG_DIR/straight"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

info()    { echo -e "${BLUE}→${NC} $1"; }
success() { echo -e "${GREEN}✓${NC} $1"; }
warn()    { echo -e "${YELLOW}!${NC} $1"; }
error()   { echo -e "${RED}✗${NC} $1"; exit 1; }

usage() {
    cat <<EOF
Usage: emacs-up [COMMAND]

Commands:
  update     Pull all packages from upstream (default)
  rebuild    Rebuild all packages (after Emacs upgrade)
  freeze     Save current versions to versions.lock
  thaw       Restore packages from versions.lock
  clean      Remove unused packages and repos
  purge      Remove entire straight directory (nuclear option)
  status     Show package counts and lockfile status

Examples:
  emacs-up           # Update all packages
  emacs-up rebuild   # Rebuild after Emacs version change
  emacs-up freeze    # Lock current versions
EOF
}

check_emacs() {
    if ! command -v "$EMACS" &>/dev/null; then
        error "Emacs not found. Install Emacs first or set EMACS env var."
    fi
}

check_config() {
    if [[ ! -f "$CONFIG_DIR/init.el" ]]; then
        error "No init.el found at $CONFIG_DIR\n       Configure Emacs first or set XDG_CONFIG_HOME correctly."
    fi
}

check_straight() {
    if [[ ! -d "$STRAIGHT_DIR/repos/straight.el" ]]; then
        warn "straight.el not found. Starting Emacs to bootstrap..."
        # Start Emacs in batch mode to trigger straight bootstrap
        "$EMACS" --batch \
            --eval "(setq user-emacs-directory \"$CONFIG_DIR/\")" \
            --eval "(load \"$CONFIG_DIR/early-init.el\" nil t)" \
            --eval "(load \"$CONFIG_DIR/init.el\" nil t)" \
            2>&1 | grep -v "^Loading\|^Wrote\|^Warnings\|^Compiling" || true

        if [[ ! -d "$STRAIGHT_DIR/repos/straight.el" ]]; then
            error "Failed to bootstrap straight.el. Check your init.el configuration."
        fi
        success "straight.el bootstrapped"
    fi
}

run_straight_cmd() {
    local cmd="$1"
    "$EMACS" --batch \
        --eval "(setq user-emacs-directory \"$CONFIG_DIR/\")" \
        --eval "(load \"$CONFIG_DIR/early-init.el\" nil t)" \
        --eval "(load \"$CONFIG_DIR/init.el\" nil t)" \
        --eval "($cmd)" \
        2>&1 | grep -v "^Loading\|^Wrote\|^Compiling\|^Saving\|^Checking" || true
}

cmd_update() {
    check_emacs
    check_config
    check_straight

    info "Updating straight.el packages..."
    run_straight_cmd "straight-pull-all"
    success "Packages updated"

    # Show summary
    if [[ -f "$STRAIGHT_DIR/versions.lock.el" ]]; then
        local count
        count=$(grep -c "(:type" "$STRAIGHT_DIR/versions.lock.el" 2>/dev/null || echo "0")
        info "Lockfile has $count packages"
    fi
}

cmd_rebuild() {
    check_emacs
    check_config
    check_straight

    info "Rebuilding all packages..."
    run_straight_cmd "straight-rebuild-all"
    success "Packages rebuilt"
}

cmd_freeze() {
    check_emacs
    check_config
    check_straight

    info "Freezing package versions..."
    run_straight_cmd "straight-freeze-versions"
    success "Versions saved to $STRAIGHT_DIR/versions.lock.el"
}

cmd_thaw() {
    check_emacs
    check_config

    if [[ ! -f "$STRAIGHT_DIR/versions.lock.el" ]]; then
        error "No versions.lock.el found. Run 'emacs-up freeze' first."
    fi

    check_straight

    info "Thawing packages from lockfile..."
    run_straight_cmd "straight-thaw-versions"
    success "Packages restored from lockfile"
}

cmd_clean() {
    check_emacs
    check_config
    check_straight

    info "Cleaning unused packages..."
    run_straight_cmd "progn (straight-prune-build) (straight-remove-unused-repos)"
    success "Cleaned unused packages"
}

cmd_purge() {
    if [[ ! -d "$STRAIGHT_DIR" ]]; then
        warn "Straight directory doesn't exist: $STRAIGHT_DIR"
        exit 0
    fi

    warn "This will delete $STRAIGHT_DIR entirely!"
    read -rp "Continue? [y/N] " confirm

    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        rm -rf "$STRAIGHT_DIR"
        success "Straight directory removed. Run emacs to reinstall."
    else
        info "Aborted"
    fi
}

cmd_status() {
    check_emacs

    echo -e "${BLUE}Emacs Config Status${NC}"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

    # Emacs version
    local emacs_ver
    emacs_ver=$("$EMACS" --version | head -1 2>/dev/null || echo "not found")
    echo -e "Emacs:          ${GREEN}$emacs_ver${NC}"

    # Config dir
    if [[ -d "$CONFIG_DIR" ]]; then
        echo -e "Config dir:     ${GREEN}$CONFIG_DIR${NC}"
    else
        echo -e "Config dir:     ${RED}not found${NC}"
        exit 0
    fi

    # init.el
    if [[ -f "$CONFIG_DIR/init.el" ]]; then
        echo -e "init.el:        ${GREEN}found${NC}"
    else
        echo -e "init.el:        ${RED}not found${NC}"
        exit 0
    fi

    # early-init.el
    if [[ -f "$CONFIG_DIR/early-init.el" ]]; then
        echo -e "early-init.el:  ${GREEN}found${NC}"
    else
        echo -e "early-init.el:  ${YELLOW}not found${NC}"
    fi

    # Straight dir
    if [[ -d "$STRAIGHT_DIR" ]]; then
        local repo_count build_count
        repo_count=$(find "$STRAIGHT_DIR/repos" -maxdepth 1 -type d 2>/dev/null | tail -n +2 | wc -l)
        build_count=$(find "$STRAIGHT_DIR/build" -maxdepth 1 -type d 2>/dev/null | tail -n +2 | wc -l)
        echo -e "Straight dir:   ${GREEN}initialized${NC}"
        echo -e "Repos:          ${GREEN}$repo_count${NC}"
        echo -e "Builds:         ${GREEN}$build_count${NC}"
    else
        echo -e "Straight dir:   ${YELLOW}not initialized${NC}"
        exit 0
    fi

    # Lockfile
    if [[ -f "$STRAIGHT_DIR/versions.lock.el" ]]; then
        local lock_count
        lock_count=$(grep -c "(:type" "$STRAIGHT_DIR/versions.lock.el" 2>/dev/null || echo "0")
        local lock_age
        lock_age=$(stat -c %Y "$STRAIGHT_DIR/versions.lock.el" 2>/dev/null || stat -f %m "$STRAIGHT_DIR/versions.lock.el" 2>/dev/null || echo "0")
        local lock_date
        lock_date=$(date -d "@$lock_age" "+%Y-%m-%d %H:%M" 2>/dev/null || date -r "$lock_age" "+%Y-%m-%d %H:%M" 2>/dev/null || echo "unknown")
        echo -e "Lockfile:       ${GREEN}$lock_count packages (last: $lock_date)${NC}"
    else
        echo -e "Lockfile:       ${YELLOW}not found${NC}"
    fi

    # Straight version
    if [[ -f "$STRAIGHT_DIR/repos/straight.el/straight.el" ]]; then
        local straight_version
        straight_version=$(grep -m1 "Version:" "$STRAIGHT_DIR/repos/straight.el/straight.el" 2>/dev/null | awk '{print $3}' || echo "unknown")
        echo -e "Straight ver:   ${GREEN}$straight_version${NC}"
    fi
}

# Main
case "${1:-update}" in
    update)  cmd_update ;;
    rebuild) cmd_rebuild ;;
    freeze)  cmd_freeze ;;
    thaw)    cmd_thaw ;;
    clean)   cmd_clean ;;
    purge)   cmd_purge ;;
    status)  cmd_status ;;
    -h|--help|help) usage ;;
    *)       error "Unknown command: $1. Use --help for usage." ;;
esac
